# Copy to .env.local (gitignored) and fill in. Restart Metro after changing.
# Without these the app runs in demo mode: local mock backend, demo places, straight-line routes, no map tiles.

# Supabase (Project Settings -> API). Run supabase/schema.sql in the SQL editor first.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Mapbox public token (starts with pk.). Used for map tiles, directions and place search.
EXPO_PUBLIC_MAPBOX_TOKEN=
