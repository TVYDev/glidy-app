# Copy to .env.local (gitignored) and fill in. Restart Metro after changing.
# Without these the app runs in demo mode: local mock backend, demo places, straight-line routes, no map tiles.

# Supabase (Project Settings -> API). Run supabase/schema.sql in the SQL editor first.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Maps Platform key. One key for the native map, place search, routes and pin naming.
# Enable: Maps SDK for iOS, Maps SDK for Android, Places API (New), Routes API, Geocoding API.
# Restrict it in Google Cloud (apps + those APIs) and set a budget alert and daily quotas.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
